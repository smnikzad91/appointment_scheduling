# Copy to .env and fill in. Everything apps/web reads at build or run time.

# Postgres — the same database apps/api uses (packages/database/prisma/schema.prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_scheduling?schema=public"

# NextAuth: secret for signing session cookies (openssl rand -base64 32).
AUTH_SECRET="change-me"

# apps/api base URL. API_URL is used server-side (NextAuth login proxy);
# NEXT_PUBLIC_API_URL is also used by the browser (salon page, booking flow, panels).
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Public origin of this site — canonical URLs, sitemap, structured data, share images,
# booking links. Must be set in production (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional: Telegram channel notifications when blog/news/announcements are published.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL=""
# Optional SOCKS proxy for reaching Telegram, e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY=""
