# Copy to .env and fill in. Everything apps/web reads at build or run time.

# Postgres — the same database apps/api uses (packages/database/prisma/schema.prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_scheduling?schema=public"

# NextAuth: secret for signing session cookies (openssl rand -base64 32).
AUTH_SECRET="change-me"

# apps/api base URL. API_URL is used for every server-side call (NextAuth login, SSR of salon
# pages, showcase, sitemap, OG images) — in production the internal http://127.0.0.1:3011, never the
# public domain (that would go out through Cloudflare and back). NEXT_PUBLIC_API_URL is the public
# URL the browser uses (salon page, booking flow, panels); it's baked in at build.
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Public origin of this site — canonical URLs, sitemap, structured data, share images,
# booking links. Must be set in production (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional: Telegram channel notifications when blog/news/announcements are published.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL=""
# Optional SOCKS proxy for reaching Telegram, e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY=""

# Android app links (apps/android): SHA-256 fingerprints of the app signing certificate(s), comma-separated.
# keytool -list -v -keystore release.jks -alias <alias>  → "SHA256: AA:BB:…"
ANDROID_CERT_SHA256=

# Android app APKs for /download/nobatet-<versionCode>.apk (in-app updates of the `direct` build).
# A folder on the server outside the repo — APKs never go into git. See apps/android/RELEASING.md.
APK_DIR="/var/lib/nobatet/apk"

# Bank-SMS agent (apps/bank-sms-agent on the BeagleBone): shared HMAC secret = its DEVICE_SECRET.
# Generate with: openssl rand -hex 32. Empty = /api/bank-sms/* refuses every request.
BANK_SMS_DEVICE_SECRET=
