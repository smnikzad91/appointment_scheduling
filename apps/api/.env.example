DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_scheduling?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001

# SMS (src/sms). "log" (default) only writes messages to the server log; "provider" sends
# through notifycloud.ir (src/sms/drivers/provider.driver.ts). Put the real key only in .env.
SMS_DRIVER="log"
SMS_API_URL="https://notifycloud.ir"
# ncsms_… key; each key has its own prepaid balance
SMS_API_KEY=""
SMS_SENDER=""
# template/pattern ids, if the provider uses templates
SMS_TEMPLATE_OTP=""
SMS_TEMPLATE_REMINDER_CUSTOMER=""
SMS_TEMPLATE_REMINDER_STYLIST=""
# site host for the WebOTP last line "@host #code" (Chrome/Android autofills the code); must
# match the domain users open. Change it with the domain; empty = no WebOTP line.
SMS_OTP_DOMAIN="dev-iot.ir"
# "off" disables the 1-hour-before reminders
SMS_REMINDERS="on"
# Salon-local hours when the stylist's "new booking" and "still unconfirmed" texts wait until morning
# (unless the booking starts before then). "HH:MM-HH:MM", may cross midnight; "off" disables.
# Login codes, 1-hour reminders and the customer's booking texts are never held back.
SMS_QUIET_HOURS="22:00-08:00"
