DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_scheduling?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001

# notifycloud.ir SMS gateway. Leave the key empty in dev: OTP codes are then not sent,
# and /auth/otp/request returns the code as devCode instead (outside production).
NOTIFYCLOUD_BASE_URL=https://notifycloud.ir
NOTIFYCLOUD_API_KEY=
# SMS reminder this many hours before an appointment (not sent 22:00–08:00 salon time).
APPOINTMENT_REMINDER_HOURS=3
