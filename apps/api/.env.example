DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_scheduling?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001

# SMS (src/sms). "log" (default) only writes messages to the server log; "provider" sends
# through src/sms/drivers/provider.driver.ts. Put real credentials only in .env, never here.
SMS_DRIVER="log"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER=""
# template/pattern ids, if the provider uses templates
SMS_TEMPLATE_OTP=""
SMS_TEMPLATE_REMINDER_CUSTOMER=""
SMS_TEMPLATE_REMINDER_STYLIST=""
# "off" disables the 1-hour-before reminders
SMS_REMINDERS="on"
