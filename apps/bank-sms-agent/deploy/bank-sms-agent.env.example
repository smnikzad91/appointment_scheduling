# /etc/bank-sms-agent.env (chmod 600). DEVICE_SECRET = BANK_SMS_DEVICE_SECRET in apps/web/.env.production.
SERIAL_DEVICE=/dev/ttyS1
SERIAL_BAUD=115200
SERVER_URL=https://nobatet.app
DEVICE_ID=bbb-bank-1
DEVICE_SECRET=
DATA_DIR=/var/lib/bank-sms-agent
# Optional: a GPIO (sysfs number, already exported as output) wired to the SIM800C PWRKEY, pulsed when the modem hangs
PWRKEY_GPIO=
