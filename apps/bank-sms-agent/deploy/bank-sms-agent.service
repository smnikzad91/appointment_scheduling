# /etc/systemd/system/bank-sms-agent.service — see apps/bank-sms-agent/README.md
[Unit]
Description=nobatet bank-SMS agent (SIM800C → platform)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/bank-sms-agent.env
ExecStart=/usr/bin/node /opt/bank-sms-agent/src/index.mjs
Restart=always
RestartSec=10
# the UART device is group dialout; the queue lives in /var/lib/bank-sms-agent
User=bank-sms
Group=dialout
StateDirectory=bank-sms-agent

[Install]
WantedBy=multi-user.target
