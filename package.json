{
  "name": "appointment-scheduling",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "build:prod": "npm run build -w api && npm run build -w web",
    "deploy": "npm run build:prod && npm run migrate:deploy -w @appointment-scheduling/database && pm2 startOrReload ecosystem.config.cjs --update-env && pm2 save"
  },
  "devDependencies": {
    "next": "*",
    "turbo": "^2.5.8"
  },
  "overrides": {
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
