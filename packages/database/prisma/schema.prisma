generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SALON_OWNER
  STYLIST
  CUSTOMER
}

enum SalonStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketReplySender {
  USER
  ADMIN
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTarget {
  SALON
  STYLIST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_REVIEW
  NEW_BOOKING
  BOOKING_CANCELLED
  PAYOUT_RECORDED
  BOOKING_CONFIRMED
  REVIEW_APPROVED
  SLOT_OPENED
  BOOKING_UPDATED
}

enum PayoutMethod {
  CASH
  CARD_TO_CARD
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  RENT
  SUPPLIES
  SALARIES
  UTILITIES
  EQUIPMENT
  MARKETING
  OTHER
}

// A stylist's own work costs (tracked in the stylist panel), for their net income.
enum StylistExpenseCategory {
  SUPPLIES // consumable materials
  PRODUCTS // products bought (for work or resale)
  TOOLS // tool purchase or maintenance
  TRAINING
  TRANSPORT
  OTHER
}

enum ErrorSource {
  API // apps/api (NestJS)
  WEB_SERVER // apps/web server side: route handlers, server components, server actions
  WEB_CLIENT // apps/web in the browser
}

enum LegalPageType {
  PRIVACY
  TERMS
}

enum SocialPlatform {
  TELEGRAM
  INSTAGRAM
  TWITTER
  YOUTUBE
  LINKEDIN
  WHATSAPP
  DISCORD
  GITHUB
  FACEBOOK
  TIKTOK
}

model User {
  id              String   @id @default(cuid())
  phone           String?  @unique
  email           String?  @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  role            Role
  walletBalance   Int      @default(0)
  /// True for an invited stylist until they choose a password via their one-time link (their
  /// passwordHash until then is random and unknown to anyone).
  mustSetPassword Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownedSalons         Salon[]              @relation("SalonOwner")
  stylist             Stylist?
  appointments        Appointment[]        @relation("CustomerAppointments")
  tickets             Ticket[]
  cards               Card[]
  deposits            Deposit[]
  notifications       Notification[]
  favoriteSalons      FavoriteSalon[]
  waitlistEntries     WaitlistEntry[]
  passwordSetupTokens PasswordSetupToken[]

  @@map("users")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_categories")
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  category   String
  title      String
  excerpt    String
  coverImage String?
  readTime   String
  hashtags   String[]
  // array of { heading?: string, body: string, image?: string }
  sections   Json
  highlight  Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
  @@map("blog_posts")
}

model NewsTag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news_tags")
}

model NewsItem {
  id          String   @id @default(cuid())
  category    String
  hashtags    String[]
  title       String
  body        String
  image       String?
  coverImage  String?
  highlight   Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@map("news_items")
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  link      String   @default("")
  linkText  String   @default("")
  emoji     String   @default("🎉")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model LegalPage {
  id        String        @id @default(cuid())
  type      LegalPageType @unique
  title     String
  content   String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("legal_pages")
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  label     String         @default("")
  active    Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("social_links")
}

model SiteSeo {
  id          String   @id @default(cuid())
  title       String
  description String
  keywords    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_seo")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_messages")
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  images    String[]
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@map("tickets")
}

model TicketReply {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    Ticket            @relation(fields: [ticketId], references: [id])
  sender    TicketReplySender
  message   String
  images    String[]
  createdAt DateTime          @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

model Card {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  cardNumber String   @unique
  ownerName  String
  bankName   String
  createdAt  DateTime @default(now())

  deposits Deposit[]

  @@index([userId])
  @@map("cards")
}

model AdminCard {
  id         String   @id @default(cuid())
  cardNumber String   @unique
  ownerName  String
  bankName   String
  createdAt  DateTime @default(now())

  @@map("admin_cards")
}

model Deposit {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  cardId           String
  card             Card          @relation(fields: [cardId], references: [id])
  amount           Int
  description      String        @default("")
  receiptImage     String        @default("")
  status           DepositStatus @default(PENDING)
  adminNote        String        @default("")
  interceptionCode String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@map("deposits")
}

model Salon {
  id            String       @id @default(cuid())
  ownerId       String
  owner         User         @relation("SalonOwner", fields: [ownerId], references: [id])
  name          String
  slug          String       @unique
  description   String?
  // Province (استان) and county (شهرستان) from packages/iran-locations; province is null only on
  // salons created before it existed whose city didn't match the list.
  province      String?
  city          String
  address       String
  phone         String
  instagram     String?
  timezone      String       @default("Asia/Tehran")
  logoUrl       String?
  coverImageUrl String?
  brandColor    String       @default("#a34a30")
  latitude      Float?
  longitude     Float?
  status        SalonStatus  @default(PENDING)
  // Subscription (apps/api src/subscriptions): no plan = no limits (salons from before plans
  // existed, until the admin assigns one). planExpiresAt null = no end date.
  planId        String?
  plan          PricingPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  planExpiresAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  stylists          Stylist[]
  smsUsage          SalonSmsUsage[]
  services          Service[]
  serviceCategories ServiceCategory[]
  appointments      Appointment[]
  galleryImages     GalleryImage[]
  reviews           Review[]
  payouts           StylistPayout[]
  expenses          SalonExpense[]
  stylistExpenses   StylistExpense[]
  featured          FeaturedSalon?
  favoritedBy       FavoriteSalon[]
  waitlist          WaitlistEntry[]

  @@index([province, city])
  // Bounding-box prefilter for "near me" (see apps/api src/salons/salon-search.service.ts).
  @@index([latitude, longitude])
  @@map("salons")
}

model ServiceCategory {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  services Service[]

  @@index([salonId])
  @@map("service_categories")
}

model Stylist {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id])
  displayName       String
  bio               String?
  avatarUrl         String?
  coverImageUrl     String?
  // The stylist's share of the money received for their appointments, in percent (0–100). Set by
  // the owner when adding the stylist; changing it only affects appointments completed afterwards.
  commissionPercent Int      @default(20)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  services      StylistService[]
  workingHours  WorkingHour[]
  timeOff       TimeOff[]
  appointments  Appointment[]
  galleryImages GalleryImage[]
  reviews       Review[]
  payouts       StylistPayout[]
  featured      FeaturedStylist?
  waitlist      WaitlistEntry[]
  expenses      StylistExpense[]

  @@index([salonId])
  @@map("stylists")
}

model Service {
  id              String           @id @default(cuid())
  salonId         String
  salon           Salon            @relation(fields: [salonId], references: [id])
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  priceToman      Int
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())

  stylists     StylistService[]
  appointments AppointmentService[]

  @@index([salonId])
  @@map("services")
}

model StylistService {
  stylistId               String
  stylist                 Stylist @relation(fields: [stylistId], references: [id])
  serviceId               String
  service                 Service @relation(fields: [serviceId], references: [id])
  overridePriceToman      Int?
  overrideDurationMinutes Int?
  // This stylist's share for this service (0–100); null = their default commissionPercent.
  commissionPercent       Int?

  @@id([stylistId, serviceId])
  @@map("stylist_services")
}

model WorkingHour {
  id          String  @id @default(cuid())
  stylistId   String
  stylist     Stylist @relation(fields: [stylistId], references: [id])
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from midnight, e.g. 9:00 = 540
  endMinute   Int

  @@index([stylistId])
  @@map("working_hours")
}

model TimeOff {
  id        String   @id @default(cuid())
  stylistId String
  stylist   Stylist  @relation(fields: [stylistId], references: [id])
  startAt   DateTime
  endAt     DateTime
  reason    String?

  @@index([stylistId])
  @@map("time_off")
}

model Appointment {
  id                       String            @id @default(cuid())
  salonId                  String
  salon                    Salon             @relation(fields: [salonId], references: [id])
  stylistId                String
  stylist                  Stylist           @relation(fields: [stylistId], references: [id])
  customerId               String
  customer                 User              @relation("CustomerAppointments", fields: [customerId], references: [id])
  startAt                  DateTime
  endAt                    DateTime
  status                   AppointmentStatus @default(PENDING)
  priceToman               Int
  notes                    String?
  // Accounting, frozen when the appointment is COMPLETED and cleared if it leaves that status:
  // the amount actually received (defaults to priceToman; the owner can correct it), the stylist's
  // commission percent at that moment, and their share. The salon's share is the rest.
  chargedToman             Int?
  // Effective percent: price-weighted across the services when some have their own rate.
  stylistCommissionPercent Float?
  // Tip for the stylist (100% theirs); included in stylistShareToman.
  tipToman                 Int?
  stylistShareToman        Int?
  completedAt              DateTime?
  // When the "1 hour before" SMS went out (customer + stylist); cleared when the time changes.
  reminderSentAt           DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  services AppointmentService[]
  reviews  Review[]

  @@index([salonId, startAt])
  @@index([stylistId, startAt])
  @@map("appointments")
}

model AppointmentService {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  // Snapshotted at booking time so a later price change doesn't alter past appointments.
  priceToman      Int
  durationMinutes Int

  @@index([appointmentId])
  @@map("appointment_services")
}

/// One-time "set your password" link for an invited stylist (the salon owner can regenerate it).
/// Only a SHA-256 of the link's secret is stored; using it or issuing a new one ends the old one.
model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_setup_tokens")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  // Wrong guesses against this code; it's burned after OTP_MAX_ATTEMPTS (apps/api auth.service).
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

// A customer's rating (1–5) and/or comment after a completed appointment — either may be missing
// but not both (reviews_rating_or_comment check constraint, added in SQL). Each appointment can have
// one review of the salon and one of its stylist. Reviews start PENDING and only APPROVED ones are
// public: the salon owner moderates all of the salon's reviews, a stylist those about them.
model Review {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  salonId       String
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  target        ReviewTarget
  // The appointment's stylist; set only when target = STYLIST.
  stylistId     String?
  stylist       Stylist?     @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  rating        Int?
  comment       String?
  status        ReviewStatus @default(PENDING)
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([appointmentId, target])
  @@index([salonId, status, createdAt])
  @@index([stylistId, status, createdAt])
  @@map("reviews")
}

// Application errors from every app, shown on the platform-admin dashboard (/admin).
// userId is a plain column, not a relation, so a log survives the user being deleted.
model ErrorLog {
  id         String      @id @default(cuid())
  source     ErrorSource
  message    String
  stack      String?
  method     String?
  path       String?
  statusCode Int?
  userId     String?
  userAgent  String?
  context    Json?
  resolved   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([resolved, createdAt])
  @@map("error_logs")
}

// Photos of finished work ("artworks") shown on the public salon page. Every image belongs to a
// salon; stylistId marks it as that stylist's portfolio piece (the stylist can manage their own,
// the owner can manage all of the salon's). Files live under apps/web's /uploads.
model GalleryImage {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistId String?
  stylist   Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([salonId, createdAt])
  @@index([stylistId])
  @@map("gallery_images")
}

// In-app notifications shown behind the bell in the salon and stylist panels. `data` is the
// type-specific payload (ids, names, rating…); clients build the Persian text from it, so the
// wording can change without rewriting stored rows.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Money the salon paid a stylist (settling their commission, or an advance). A stylist's balance
// is their commission from completed appointments minus these payouts.
model StylistPayout {
  id          String       @id @default(cuid())
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistId   String
  stylist     Stylist      @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  amountToman Int
  method      PayoutMethod
  paidAt      DateTime
  note        String?
  createdAt   DateTime     @default(now())

  @@index([salonId, paidAt])
  @@index([stylistId, paidAt])
  @@map("stylist_payouts")
}

// A salon's running costs (rent, supplies…), for its profit & loss.
model SalonExpense {
  id          String          @id @default(cuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amountToman Int
  spentAt     DateTime
  note        String?
  createdAt   DateTime        @default(now())

  @@index([salonId, spentAt])
  @@map("salon_expenses")
}

// A stylist's own work costs, logged by the stylist in their panel. Subtracted from their share of
// completed appointments to give their net income; never touches the salon's books.
model StylistExpense {
  id          String                 @id @default(cuid())
  stylistId   String
  stylist     Stylist                @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  // The stylist's salon when it was logged (a stylist belongs to one salon).
  salonId     String
  salon       Salon                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category    StylistExpenseCategory
  amountToman Int
  spentAt     DateTime
  description String
  // Photo of the receipt/invoice, uploaded through apps/web (/uploads/expenses/…).
  receiptUrl  String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([stylistId, spentAt])
  @@index([salonId])
  @@map("stylist_expenses")
}

// ── Home page showcase (edited by the platform admin) ─────────────────────

// The supplier/sponsor banner on the home page. Singleton row (id "singleton").
model HomeBanner {
  id        String   @id @default("singleton")
  imageUrl  String?
  // Where the banner points (http/https only).
  linkUrl   String?
  // Supplier name / alt text.
  title     String?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("home_banner")
}

// Up to three salons featured on the home page; priority 1 is shown first.
model FeaturedSalon {
  salonId   String   @id
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  priority  Int      @unique
  createdAt DateTime @default(now())

  @@map("featured_salons")
}

// Up to three stylists featured on the home page; priority 1 is shown first.
model FeaturedStylist {
  stylistId String   @id
  stylist   Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  priority  Int      @unique
  createdAt DateTime @default(now())

  @@map("featured_stylists")
}

// Showcase options (singleton, id "singleton").
model ShowcaseSettings {
  id         String   @id @default("singleton")
  // A salon/stylist needs at least this many approved star ratings to appear in "top rated".
  minRatings Int      @default(3)
  updatedAt  DateTime @updatedAt

  @@map("showcase_settings")
}

// A customer's saved salons ("علاقه‌مندی‌ها").
model FavoriteSalon {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, salonId])
  @@index([salonId])
  @@map("favorite_salons")
}

// "Tell me if a time opens up": a customer waiting for a salon-local day (optionally one stylist)
// that had no free slot. When an appointment on that day is cancelled, waiting customers get a
// SLOT_OPENED notification (notifiedAt set, so each entry is notified once).
model WaitlistEntry {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salonId    String
  salon      Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistId  String?
  stylist    Stylist?  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  /**
   * Salon-local day, "YYYY-MM-DD".
   */
  dateKey    String
  serviceIds String[]
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, salonId, dateKey])
  @@index([salonId, dateKey])
  @@map("waitlist_entries")
}

// Salon subscription plans: the landing page's pricing section and each salon's limits. Edited at
// /admin/pricing (apps/web, Prisma directly); enforced by apps/api (src/subscriptions).
model PricingPlan {
  id                String   @id @default(cuid())
  name              String
  description       String?
  // null = negotiated price ("توافقی"), 0 = free
  monthlyPriceToman Int?
  // Enforced by apps/api for salons on this plan: null = unlimited stylists; reminder SMS per
  // Jalali month, null = none included.
  maxStylists       Int?
  smsPerMonth       Int?
  // Extra feature lines, shown after the generated stylist/SMS lines
  features          String[]
  recommended       Boolean  @default(false)
  ctaLabel          String   @default("انتخاب پلن")
  ctaHref           String   @default("/signup-salon")
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salons Salon[]

  @@index([active, sortOrder])
  @@map("pricing_plans")
}

model PricingSettings {
  id        String   @id @default("singleton")
  // Free trial length shown under the pricing heading; 0 hides it.
  trialDays Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("pricing_settings")
}

// Reminder SMS sent per salon per Jalali month ("1405-07", salon timezone), checked against the
// plan's smsPerMonth before each send (apps/api src/sms/reminder.service.ts).
model SalonSmsUsage {
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  period  String
  sent    Int    @default(0)

  @@id([salonId, period])
  @@map("salon_sms_usage")
}
