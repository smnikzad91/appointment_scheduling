generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SALON_OWNER
  STYLIST
  CUSTOMER
}

enum SalonStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketReplySender {
  USER
  ADMIN
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTarget {
  SALON
  STYLIST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_REVIEW
}

enum PayoutMethod {
  CASH
  CARD_TO_CARD
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  RENT
  SUPPLIES
  SALARIES
  UTILITIES
  EQUIPMENT
  MARKETING
  OTHER
}

enum ErrorSource {
  API // apps/api (NestJS)
  WEB_SERVER // apps/web server side: route handlers, server components, server actions
  WEB_CLIENT // apps/web in the browser
}

enum LegalPageType {
  PRIVACY
  TERMS
}

enum SocialPlatform {
  TELEGRAM
  INSTAGRAM
  TWITTER
  YOUTUBE
  LINKEDIN
  WHATSAPP
  DISCORD
  GITHUB
  FACEBOOK
  TIKTOK
}

model User {
  id            String   @id @default(cuid())
  phone         String?  @unique
  email         String?  @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  role          Role
  walletBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedSalons   Salon[]        @relation("SalonOwner")
  stylist       Stylist?
  appointments  Appointment[]  @relation("CustomerAppointments")
  tickets       Ticket[]
  cards         Card[]
  deposits      Deposit[]
  notifications Notification[]

  @@map("users")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_categories")
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  category   String
  title      String
  excerpt    String
  coverImage String?
  readTime   String
  hashtags   String[]
  // array of { heading?: string, body: string, image?: string }
  sections   Json
  highlight  Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
  @@map("blog_posts")
}

model NewsTag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news_tags")
}

model NewsItem {
  id          String   @id @default(cuid())
  category    String
  hashtags    String[]
  title       String
  body        String
  image       String?
  coverImage  String?
  highlight   Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@map("news_items")
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  link      String   @default("")
  linkText  String   @default("")
  emoji     String   @default("🎉")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model LegalPage {
  id        String        @id @default(cuid())
  type      LegalPageType @unique
  title     String
  content   String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("legal_pages")
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  label     String         @default("")
  active    Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("social_links")
}

model SiteSeo {
  id          String   @id @default(cuid())
  title       String
  description String
  keywords    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_seo")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_messages")
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  images    String[]
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@map("tickets")
}

model TicketReply {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    Ticket            @relation(fields: [ticketId], references: [id])
  sender    TicketReplySender
  message   String
  images    String[]
  createdAt DateTime          @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

model Card {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  cardNumber String   @unique
  ownerName  String
  bankName   String
  createdAt  DateTime @default(now())

  deposits Deposit[]

  @@index([userId])
  @@map("cards")
}

model AdminCard {
  id         String   @id @default(cuid())
  cardNumber String   @unique
  ownerName  String
  bankName   String
  createdAt  DateTime @default(now())

  @@map("admin_cards")
}

model Deposit {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  cardId           String
  card             Card          @relation(fields: [cardId], references: [id])
  amount           Int
  description      String        @default("")
  receiptImage     String        @default("")
  status           DepositStatus @default(PENDING)
  adminNote        String        @default("")
  interceptionCode String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@map("deposits")
}

model Salon {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation("SalonOwner", fields: [ownerId], references: [id])
  name          String
  slug          String      @unique
  description   String?
  city          String
  address       String
  phone         String
  instagram     String?
  timezone      String      @default("Asia/Tehran")
  logoUrl       String?
  coverImageUrl String?
  brandColor    String      @default("#a34a30")
  latitude      Float?
  longitude     Float?
  status        SalonStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  stylists          Stylist[]
  services          Service[]
  serviceCategories ServiceCategory[]
  appointments      Appointment[]
  galleryImages     GalleryImage[]
  reviews           Review[]
  payouts           StylistPayout[]
  expenses          SalonExpense[]
  featured          FeaturedSalon?

  @@map("salons")
}

model ServiceCategory {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  services Service[]

  @@index([salonId])
  @@map("service_categories")
}

model Stylist {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id])
  displayName       String
  bio               String?
  avatarUrl         String?
  coverImageUrl     String?
  // The stylist's share of the money received for their appointments, in percent (0–100). Set by
  // the owner when adding the stylist; changing it only affects appointments completed afterwards.
  commissionPercent Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  services      StylistService[]
  workingHours  WorkingHour[]
  timeOff       TimeOff[]
  appointments  Appointment[]
  galleryImages GalleryImage[]
  reviews       Review[]
  payouts       StylistPayout[]
  featured      FeaturedStylist?

  @@index([salonId])
  @@map("stylists")
}

model Service {
  id              String           @id @default(cuid())
  salonId         String
  salon           Salon            @relation(fields: [salonId], references: [id])
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  priceToman      Int
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())

  stylists     StylistService[]
  appointments AppointmentService[]

  @@index([salonId])
  @@map("services")
}

model StylistService {
  stylistId               String
  stylist                 Stylist @relation(fields: [stylistId], references: [id])
  serviceId               String
  service                 Service @relation(fields: [serviceId], references: [id])
  overridePriceToman      Int?
  overrideDurationMinutes Int?

  @@id([stylistId, serviceId])
  @@map("stylist_services")
}

model WorkingHour {
  id          String  @id @default(cuid())
  stylistId   String
  stylist     Stylist @relation(fields: [stylistId], references: [id])
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from midnight, e.g. 9:00 = 540
  endMinute   Int

  @@index([stylistId])
  @@map("working_hours")
}

model TimeOff {
  id        String   @id @default(cuid())
  stylistId String
  stylist   Stylist  @relation(fields: [stylistId], references: [id])
  startAt   DateTime
  endAt     DateTime
  reason    String?

  @@index([stylistId])
  @@map("time_off")
}

model Appointment {
  id                       String            @id @default(cuid())
  salonId                  String
  salon                    Salon             @relation(fields: [salonId], references: [id])
  stylistId                String
  stylist                  Stylist           @relation(fields: [stylistId], references: [id])
  customerId               String
  customer                 User              @relation("CustomerAppointments", fields: [customerId], references: [id])
  startAt                  DateTime
  endAt                    DateTime
  status                   AppointmentStatus @default(PENDING)
  priceToman               Int
  notes                    String?
  // Accounting, frozen when the appointment is COMPLETED and cleared if it leaves that status:
  // the amount actually received (defaults to priceToman; the owner can correct it), the stylist's
  // commission percent at that moment, and their share. The salon's share is the rest.
  chargedToman             Int?
  stylistCommissionPercent Int?
  stylistShareToman        Int?
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  services AppointmentService[]
  reviews  Review[]

  @@index([salonId, startAt])
  @@index([stylistId, startAt])
  @@map("appointments")
}

model AppointmentService {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  // Snapshotted at booking time so a later price change doesn't alter past appointments.
  priceToman      Int
  durationMinutes Int

  @@index([appointmentId])
  @@map("appointment_services")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

// A customer's rating (1–5) and/or comment after a completed appointment — either may be missing
// but not both (reviews_rating_or_comment check constraint, added in SQL). Each appointment can have
// one review of the salon and one of its stylist. Reviews start PENDING and only APPROVED ones are
// public: the salon owner moderates all of the salon's reviews, a stylist those about them.
model Review {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  salonId       String
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  target        ReviewTarget
  // The appointment's stylist; set only when target = STYLIST.
  stylistId     String?
  stylist       Stylist?     @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  rating        Int?
  comment       String?
  status        ReviewStatus @default(PENDING)
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([appointmentId, target])
  @@index([salonId, status, createdAt])
  @@index([stylistId, status, createdAt])
  @@map("reviews")
}

// Application errors from every app, shown on the platform-admin dashboard (/admin).
// userId is a plain column, not a relation, so a log survives the user being deleted.
model ErrorLog {
  id         String      @id @default(cuid())
  source     ErrorSource
  message    String
  stack      String?
  method     String?
  path       String?
  statusCode Int?
  userId     String?
  userAgent  String?
  context    Json?
  resolved   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([resolved, createdAt])
  @@map("error_logs")
}

// Photos of finished work ("artworks") shown on the public salon page. Every image belongs to a
// salon; stylistId marks it as that stylist's portfolio piece (the stylist can manage their own,
// the owner can manage all of the salon's). Files live under apps/web's /uploads.
model GalleryImage {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistId String?
  stylist   Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([salonId, createdAt])
  @@index([stylistId])
  @@map("gallery_images")
}

// In-app notifications shown behind the bell in the salon and stylist panels. `data` is the
// type-specific payload (ids, names, rating…); clients build the Persian text from it, so the
// wording can change without rewriting stored rows.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Money the salon paid a stylist (settling their commission, or an advance). A stylist's balance
// is their commission from completed appointments minus these payouts.
model StylistPayout {
  id          String       @id @default(cuid())
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylistId   String
  stylist     Stylist      @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  amountToman Int
  method      PayoutMethod
  paidAt      DateTime
  note        String?
  createdAt   DateTime     @default(now())

  @@index([salonId, paidAt])
  @@index([stylistId, paidAt])
  @@map("stylist_payouts")
}

// A salon's running costs (rent, supplies…), for its profit & loss.
model SalonExpense {
  id          String          @id @default(cuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amountToman Int
  spentAt     DateTime
  note        String?
  createdAt   DateTime        @default(now())

  @@index([salonId, spentAt])
  @@map("salon_expenses")
}

// ── Home page showcase (edited by the platform admin) ─────────────────────

// The supplier/sponsor banner on the home page. Singleton row (id "singleton").
model HomeBanner {
  id        String   @id @default("singleton")
  imageUrl  String?
  // Where the banner points (http/https only).
  linkUrl   String?
  // Supplier name / alt text.
  title     String?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("home_banner")
}

// Up to three salons featured on the home page; priority 1 is shown first.
model FeaturedSalon {
  salonId   String   @id
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  priority  Int      @unique
  createdAt DateTime @default(now())

  @@map("featured_salons")
}

// Up to three stylists featured on the home page; priority 1 is shown first.
model FeaturedStylist {
  stylistId String   @id
  stylist   Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  priority  Int      @unique
  createdAt DateTime @default(now())

  @@map("featured_stylists")
}
